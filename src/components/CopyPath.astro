---
interface Props {
  path: string;
}

const { path } = Astro.props;
---
<button
  type="button"
  class="copy-path"
  data-copy={path}
  title={`Copy ${path}`}
  aria-label={`Copy path ${path}`}
>
  <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
    <rect
      x="5.5"
      y="5"
      width="8"
      height="9.5"
      rx="1.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
    ></rect>
    <path
      d="M3.5 10.5V3A1.5 1.5 0 0 1 5 1.5h6.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
    ></path>
  </svg>
</button>
