---
import CopyPath from "../CopyPath.astro";
import { displayPath, formatWhen, noteTitle, noteUpdatedAt } from "../../lib/notes";
import { vtStyle } from "../../lib/vt";
import type { TrackingFeedData } from "../../lib/home";

type Props = TrackingFeedData;
const { tracking, error } = Astro.props;
---
{error ? (
  <p class="empty">Could not load tracking notes: {error.message}</p>
) : tracking.length === 0 ? (
  <p class="empty">No tracking notes.</p>
) : (
  <ul class="list">
    {tracking.map((entry) => {
      const data = entry.data;
      const when = formatWhen(noteUpdatedAt(data));
      return (
        <li style={vtStyle("tracking", entry.id)}>
          <a class="item-link" href={`/note/${data.slug}/`}>
            <span class="item-title">{noteTitle(data)}</span>
          </a>
          <span class="item-meta">
            <span class="path-row">
              <span class="path-text">{displayPath(data.path)}</span>
              <CopyPath path={data.path} />
            </span>
            {when ? <span>{when}</span> : null}
          </span>
        </li>
      );
    })}
  </ul>
)}
