---
import CopyPath from "../CopyPath.astro";
import DiffExcerpt from "../DiffExcerpt.astro";
import { displayPath, formatWhen, noteTitle, noteUpdatedAt } from "../../lib/notes";
import { vtStyle } from "../../lib/vt";
import type { RecentFeedData } from "../../lib/home";

type Props = RecentFeedData;
const { recent, diffs, lastChange, error } = Astro.props;
const lastChangeLabel = formatWhen(lastChange);
---
{error ? (
  <p class="empty">Could not load recent docs: {error.message}</p>
) : recent.length === 0 ? (
  <p class="empty">No recent docs loaded.</p>
) : (
  <ul class="list" data-last-change={lastChange ?? ""} data-last-change-label={lastChangeLabel}>
    {recent.map((entry) => {
      const data = entry.data;
      const when = formatWhen(noteUpdatedAt(data));
      const diff = diffs.get(entry.id);
      return (
        <li class="recent-item" style={vtStyle("recent", entry.id)}>
          <a class="item-link" href={`/note/${data.slug}/`}>
            <span class="item-title">{noteTitle(data)}</span>
          </a>
          <span class="item-meta">
            <span class="path-row">
              <span class="path-text">{displayPath(data.path)}</span>
              <CopyPath path={data.path} />
            </span>
            {when ? <span>{when}</span> : null}
          </span>
          {diff ? (
            <DiffExcerpt
              key={`diff:${entry.id}`}
              text={diff.excerpt}
              truncated={diff.truncated}
              from={diff.from}
              to={diff.to}
            />
          ) : null}
        </li>
      );
    })}
  </ul>
)}
