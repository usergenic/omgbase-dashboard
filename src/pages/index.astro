---
import Base from "../layouts/Base.astro";
import QueryHint from "../components/QueryHint.astro";
import DiffWrapToggle from "../components/DiffWrapToggle.astro";
import TaskWriteback from "../components/TaskWriteback.astro";
import LiveFeeds from "../components/LiveFeeds.astro";
import RecentFeed from "../components/feeds/RecentFeed.astro";
import ProjectsFeed from "../components/feeds/ProjectsFeed.astro";
import TrackingFeed from "../components/feeds/TrackingFeed.astro";
import TasksFeed from "../components/feeds/TasksFeed.astro";
import { formatProjectsPanelQuery, formatTasksPanelQuery } from "../lib/queries";
import { loadHome } from "../lib/home";

// Every panel is a request-time OQX slice; nothing is baked at build. After
// first paint, <LiveFeeds /> keeps the panels current in place.
const home = await loadHome();
if (home.error) Astro.response.status = 502;
---
<Base
  description="Recent edits, project status, and tracking notes from omgbase"
  lastChange={home.recent.lastChange}
>
  <main class="shell">
    {home.error ? (
      <p class="empty load-error">Could not reach omg: {home.error.message}</p>
    ) : null}

    {/*
      Hero disabled to reclaim vertical space. Revisit once the vault has a
      notion of "current attention" worth surfacing here instead of a generic
      description of the panels below.
    <section class="hero">
      <h1>What you’re tracking</h1>
      <p>
        Live OQX slices from the vault — recent edits, projects by status,
        tasks by page, and notes marked <code>tracking: true</code>.
      </p>
    </section>
    */}

    <div class="grid">
      <section class="panel">
        <div class="panel-tools">
          <DiffWrapToggle />
          <QueryHint collection="recent" />
        </div>
        <h2>Recently edited</h2>
        <div data-live-panel="recent">
          <RecentFeed {...home.recent} />
        </div>
      </section>

      <div>
        <section class="panel">
          <QueryHint source={formatProjectsPanelQuery()} />
          <h2>Projects</h2>
          <div data-live-panel="projects">
            <ProjectsFeed {...home.projects} />
          </div>
        </section>

        <section class="panel" style="margin-top:2rem;">
          <QueryHint collection="tracking" />
          <h2>Tracking</h2>
          <div data-live-panel="tracking">
            <TrackingFeed {...home.tracking} />
          </div>
        </section>
      </div>
    </div>

    <section class="panel tasks-panel">
      <QueryHint source={formatTasksPanelQuery()} />
      <h2>Tasks</h2>
      <div data-live-panel="tasks">
        <TasksFeed {...home.tasks} />
      </div>
    </section>
  </main>
  <TaskWriteback />
  <LiveFeeds intervalMs={3000} />
</Base>
