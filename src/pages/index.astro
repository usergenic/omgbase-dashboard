---
import { getLiveCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import QueryHint from "../components/QueryHint.astro";
import CopyPath from "../components/CopyPath.astro";
import {
  activityForProject,
  formatWhen,
  noteTitle,
  noteUpdatedAt,
  projectPriorityRank,
  projectStatusRank,
  type NoteData,
} from "../lib/notes";
import { formatProjectsPanelQuery, formatTasksPanelQuery } from "../lib/queries";
import { fetchDiffExcerpts } from "../lib/diffs";
import { fetchTasks, tasksForProject } from "../lib/tasks";
import DiffExcerpt from "../components/DiffExcerpt.astro";
import DiffWrapToggle from "../components/DiffWrapToggle.astro";
import TaskTree from "../components/TaskTree.astro";
import ProjectTasks from "../components/ProjectTasks.astro";
import TaskWriteback from "../components/TaskWriteback.astro";

type LiveNote = { id: string; data: NoteData };

// Every panel is a request-time OQX slice; nothing is baked at build.
const [recentRes, projectsRes, trackingRes, activityRes] = await Promise.all([
  getLiveCollection("recent"),
  getLiveCollection("projects"),
  getLiveCollection("tracking"),
  getLiveCollection("activity"),
]);
const loadError =
  recentRes.error ?? projectsRes.error ?? trackingRes.error ?? activityRes.error ?? null;
if (loadError) Astro.response.status = 502;

const entriesOf = (res: { entries?: Array<{ id: string; data: Record<string, unknown> }> }): LiveNote[] =>
  (res.entries ?? []).map((e) => ({ id: e.id, data: e.data as NoteData }));

const byUpdatedDesc = (a: LiveNote, b: LiveNote) =>
  String(noteUpdatedAt(b.data) ?? "").localeCompare(String(noteUpdatedAt(a.data) ?? ""));

const recent = entriesOf(recentRes).sort(byUpdatedDesc);

const [recentDiffs, tasks] = loadError
  ? [new Map(), { open: { groups: [], total: 0 }, completed: { groups: [], total: 0 }, truncated: false }]
  : await Promise.all([fetchDiffExcerpts(recent.map((e) => e.id)), fetchTasks()]);

const projects = entriesOf(projectsRes).sort((a, b) => {
  const ra = projectStatusRank(a.data.status);
  const rb = projectStatusRank(b.data.status);
  if (ra !== rb) return ra - rb;
  const pa = projectPriorityRank(a.data.priority);
  const pb = projectPriorityRank(b.data.priority);
  if (pa !== pb) return pa - pb;
  return noteTitle(a.data).localeCompare(noteTitle(b.data));
});

const tracking = entriesOf(trackingRes).sort(byUpdatedDesc);

const activityDocs = entriesOf(activityRes).map((e) => e.data);

const lastChange = recent.reduce<string | undefined>((best, entry) => {
  const at = noteUpdatedAt(entry.data);
  if (!at) return best;
  if (!best || at > best) return at;
  return best;
}, undefined);

const byStatus = new Map<string, typeof projects>();
for (const project of projects) {
  const key = project.data.status ?? "unspecified";
  const bucket = byStatus.get(key) ?? [];
  bucket.push(project);
  byStatus.set(key, bucket);
}
---
<Base
  description="Recent edits, project status, and tracking notes from omgbase"
  lastChange={lastChange}
>
  <main class="shell">
    {loadError ? (
      <p class="empty load-error">Could not reach omg: {loadError.message}</p>
    ) : null}
    {/*
      Hero disabled to reclaim vertical space. Revisit once the vault has a
      notion of "current attention" worth surfacing here instead of a generic
      description of the panels below.
    <section class="hero">
      <h1>What you’re tracking</h1>
      <p>
        Live OQX slices from the vault — recent edits, projects by status,
        tasks by page, and notes marked <code>tracking: true</code>.
      </p>
    </section>
    */}

    <div class="grid">
      <section class="panel">
        <div class="panel-tools">
          <DiffWrapToggle />
          <QueryHint collection="recent" />
        </div>
        <h2>Recently edited</h2>
        {recent.length === 0 ? (
          <p class="empty">No recent docs loaded.</p>
        ) : (
          <ul class="list">
            {recent.map((entry) => {
              const data = entry.data as NoteData;
              const when = formatWhen(noteUpdatedAt(data));
              const diff = recentDiffs.get(entry.id);
              return (
                <li class="recent-item">
                  <a class="item-link" href={`/note/${data.slug}/`}>
                    <span class="item-title">{noteTitle(data)}</span>
                  </a>
                  <span class="item-meta">
                    <span class="path-row">
                      <span class="path-text">{data.path}</span>
                      <CopyPath path={data.path} />
                    </span>
                    {when ? <span>{when}</span> : null}
                  </span>
                  {diff ? (
                    <DiffExcerpt
                      text={diff.excerpt}
                      truncated={diff.truncated}
                      from={diff.from}
                      to={diff.to}
                    />
                  ) : null}
                </li>
              );
            })}
          </ul>
        )}
      </section>

      <div>
        <section class="panel">
          <QueryHint source={formatProjectsPanelQuery()} />
          <h2>Projects</h2>
          {projects.length === 0 ? (
            <p class="empty">No projects loaded.</p>
          ) : (
            [...byStatus.entries()].map(([status, items]) => (
              <details class="status-group" open={status === "active" ? true : undefined}>
                <summary>
                  <span class={`badge ${status}`}>{status}</span>
                  <span class="status-count">{items.length}</span>
                </summary>
                <ul class="list project-list">
                  {items.map((entry) => {
                    const data = entry.data as NoteData;
                    const activity = activityForProject(data.path, activityDocs);
                    const projectTasks = tasksForProject(data.path, tasks.open.groups);
                    const priority =
                      typeof data.priority === "number" ? data.priority : null;
                    return (
                      <li class="project-card">
                        <a class="project-link item-link" href={`/note/${data.slug}/`}>
                          <span class="item-title">
                            {noteTitle(data)}
                            {priority !== null ? (
                              <span class="priority-mark" title={`priority ${priority}`}>
                                #{priority}
                              </span>
                            ) : null}
                          </span>
                        </a>
                        <span class="item-meta">
                          <span class="path-row">
                            <span class="path-text">{data.path}</span>
                            <CopyPath path={data.path} />
                          </span>
                        </span>
                        <ProjectTasks groups={projectTasks} />
                        {activity.length > 0 ? (
                          <ul class="activity-list">
                            {activity.map((item) => {
                              const when = formatWhen(item.updatedAt);
                              return (
                                <li>
                                  <a class="item-link" href={`/note/${item.slug}/`}>
                                    <span class="activity-title">{item.title}</span>
                                  </a>
                                  <span class="item-meta">
                                    <span class="path-row">
                                      <span class="path-text">{item.path}</span>
                                      <CopyPath path={item.path} />
                                    </span>
                                    {when ? <span>{when}</span> : null}
                                  </span>
                                </li>
                              );
                            })}
                          </ul>
                        ) : null}
                      </li>
                    );
                  })}
                </ul>
              </details>
            ))
          )}
        </section>

        <section class="panel" style="margin-top:2rem;">
          <QueryHint collection="tracking" />
          <h2>Tracking</h2>
          {tracking.length === 0 ? (
            <p class="empty">No tracking notes.</p>
          ) : (
            <ul class="list">
              {tracking.map((entry) => {
                const data = entry.data as NoteData;
                const when = formatWhen(noteUpdatedAt(data));
                return (
                  <li>
                    <a class="item-link" href={`/note/${data.slug}/`}>
                      <span class="item-title">{noteTitle(data)}</span>
                    </a>
                    <span class="item-meta">
                      <span class="path-row">
                        <span class="path-text">{data.path}</span>
                        <CopyPath path={data.path} />
                      </span>
                      {when ? <span>{when}</span> : null}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      </div>
    </div>

    <section class="panel tasks-panel">
      <QueryHint source={formatTasksPanelQuery()} />
      <h2>Tasks</h2>
      <TaskTree
        open={tasks.open}
        completed={tasks.completed}
        truncated={tasks.truncated}
      />
    </section>
  </main>
  <TaskWriteback />
</Base>
